---
// Quote form: posts to the Pages Function /api/quote (Turnstile + webhook).
// Works without JavaScript; with it, errors appear without leaving the page.
const sitekey = import.meta.env.PUBLIC_TURNSTILE_SITEKEY ?? '1x00000000000000000000AA'; // Cloudflare's always-pass test key
const errors = {
	invalid: 'Please enter your name, a valid email address and a message.',
	captcha: 'The spam check did not pass. Please try again.',
	delivery: 'We could not send your request right now. Please try again in a minute or call (509) 555-0142.',
};
---

<form id="quote" method="post" action="/api/quote" class="mt-6 grid max-w-xl gap-4 rounded-xl bg-white p-6 shadow-sm ring-1 ring-black/5" novalidate>
	<noscript><p class="rounded bg-amber-50 p-3 text-sm">The spam check needs JavaScript. Without it, please call (509) 555-0142 or email sales@northline.example.</p></noscript>
	{Object.entries(errors).map(([code, text]) => (
		<p id={`quote-error-${code}`} role="alert" class="quote-error hidden target:block rounded bg-red-50 p-3 text-sm text-red-800">{text}</p>
	))}
	<label class="grid gap-1 text-sm font-medium">Name <input name="name" required autocomplete="name" class="rounded border border-black/20 px-3 py-2 font-normal" /></label>
	<label class="grid gap-1 text-sm font-medium">Company <input name="company" autocomplete="organization" class="rounded border border-black/20 px-3 py-2 font-normal" /></label>
	<label class="grid gap-1 text-sm font-medium">Email <input name="email" type="email" required autocomplete="email" class="rounded border border-black/20 px-3 py-2 font-normal" /></label>
	<label class="grid gap-1 text-sm font-medium">Product or SKU <input name="product" class="rounded border border-black/20 px-3 py-2 font-normal" /></label>
	<label class="grid gap-1 text-sm font-medium">Message <textarea name="message" required rows="5" class="rounded border border-black/20 px-3 py-2 font-normal"></textarea></label>
	<div class="cf-turnstile" data-sitekey={sitekey}></div>
	<button class="justify-self-start rounded bg-accent px-5 py-2.5 font-semibold text-white hover:brightness-110">Send request</button>
	<p class="text-xs text-ink/70">We use your details only to answer this request. Nothing is stored on this website. See the <a href="/privacy-policy/" class="underline">privacy policy</a>.</p>
</form>

<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
<script>
	const form = document.getElementById('quote') as HTMLFormElement;
	const errors = [...document.querySelectorAll<HTMLElement>('.quote-error')];
	const show = (code: string) => {
		const box = document.getElementById(`quote-error-${code}`) ?? document.getElementById('quote-error-delivery')!;
		errors.forEach((e) => e.classList.toggle('hidden', e !== box));
	};
	const params = new URLSearchParams(location.search);
	const product = params.get('product');
	if (product) (form.elements.namedItem('product') as HTMLInputElement).value = product;
	if (params.get('error')) show(params.get('error')!);

	form.addEventListener('submit', async (event) => {
		event.preventDefault();
		errors.forEach((e) => e.classList.add('hidden'));
		const res = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' }, redirect: 'manual', signal: AbortSignal.timeout(15000) }).catch(() => null);
		if (res && (res.type === 'opaqueredirect' || res.status === 303 || res.ok)) {
			location.href = '/request-a-quote/thanks/';
			return;
		}
		show(res ? (await res.json().catch(() => ({}))).error : 'delivery');
		(window as any).turnstile?.reset();
	});
</script>
