---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	href: string;
	title: string;
	text?: string | null;
	image?: ImageMetadata | null;
	badge?: string | null;
	eager?: boolean;
	/** Heading level of the card title: 2 when the cards sit right under the page h1. */
	level?: 2 | 3;
}
const { href, title, text, image, badge, eager = false, level = 3 } = Astro.props;
const Heading = `h${level}` as 'h2' | 'h3';
---

<a href={href} class="group block overflow-hidden rounded-xl bg-white shadow-sm ring-1 ring-black/5 hover:shadow-md">
	{image && (
		<Image src={image} alt="" widths={[360, 560, 720]} sizes="(min-width: 1024px) 360px, (min-width: 640px) 50vw, 100vw"
			class="aspect-[4/3] w-full object-cover" loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : 'auto'} />
	)}
	<div class="p-4">
		{badge && <span class="mb-2 inline-block rounded bg-paper px-2 py-0.5 text-xs font-semibold uppercase tracking-wide">{badge}</span>}
		<Heading class="font-semibold group-hover:underline">{title}</Heading>
		{text && <p class="mt-1 text-sm text-ink/80">{text}</p>}
	</div>
</a>
