---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { pageTitle, productCategory } from '../../lib/content';

export async function getStaticPaths() {
	return (await getCollection('products')).map((product) => ({ params: { slug: product.id }, props: { product } }));
}

const { product } = Astro.props;
const { Content } = await render(product);
const { data } = product;
const category = productCategory(data.category);
---

<BaseLayout title={pageTitle(product)} description={data.description}>
	<nav aria-label="Breadcrumb" class="text-sm text-ink/70">
		<a href="/products/" class="underline">Products</a> /
		{category && <a href={`/product-category/${category.slug}/`} class="underline">{category.name}</a>}
	</nav>
	<div class="mt-4 grid gap-8 lg:grid-cols-2">
		{data.image && (
			<Image src={data.image} alt={data.title} widths={[480, 720, 960]} sizes="(min-width: 1024px) 560px, 100vw"
				class="w-full rounded-xl" loading="eager" fetchpriority="high" />
		)}
		<div>
			<p class="text-sm font-semibold uppercase tracking-wide text-ink/70">SKU {data.sku}</p>
			<h1 class="mt-1 text-3xl font-bold">{data.title}</h1>
			<p class="mt-3 text-lg">{data.excerpt}</p>
			<table class="mt-6 w-full text-sm">
				<caption class="sr-only">Specifications</caption>
				<tbody>
					{data.specs.map((s) => (
						<tr class="border-b border-black/10"><th scope="row" class="py-2 pr-4 text-left font-medium">{s.key}</th><td class="py-2">{s.value}</td></tr>
					))}
				</tbody>
			</table>
			<div class="mt-6 flex flex-wrap gap-3">
				<a href={`/request-a-quote/?product=${encodeURIComponent(data.sku)}`} class="rounded bg-accent px-5 py-2.5 font-semibold text-white hover:brightness-110">Request a quote</a>
				{data.datasheet && <a href={data.datasheet} class="rounded border border-ink/30 px-5 py-2.5 font-semibold hover:bg-white">Datasheet (PDF)</a>}
			</div>
		</div>
	</div>
	<article class="prose mt-10 max-w-3xl"><Content /></article>
</BaseLayout>
