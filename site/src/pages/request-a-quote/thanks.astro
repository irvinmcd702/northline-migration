---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Request sent | Northline Industrial Supply">
	<h1 class="text-3xl font-bold">Thank you</h1>
	<p class="mt-3 max-w-2xl">Your request is on its way to our sales team. We reply within one business day.</p>
	<p class="mt-3 max-w-2xl text-sm text-ink/70">Demo site: your request passed the spam check but was not sent anywhere. On a client site it goes to their CRM or inbox.</p>
	<p class="mt-6"><a href="/products/" class="underline">Back to the catalog</a></p>
</BaseLayout>
