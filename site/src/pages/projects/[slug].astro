---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { pageTitle } from '../../lib/content';

export async function getStaticPaths() {
	return (await getCollection('projects')).map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { data } = project;
---

<BaseLayout title={pageTitle(project)} description={data.description}>
	<nav aria-label="Breadcrumb" class="text-sm text-ink/70"><a href="/projects/" class="underline">Projects</a></nav>
	<h1 class="mt-2 text-3xl font-bold">{data.title}</h1>
	<p class="mt-2 text-ink/80">{[data.clientType, data.location, data.year].filter(Boolean).join(' · ')}</p>
	{data.image && <Image src={data.image} alt={data.title} widths={[640, 960, 1280]} sizes="(min-width: 1152px) 1120px, 100vw" class="mt-6 w-full rounded-xl" loading="eager" fetchpriority="high" />}
	<article class="prose mt-8 max-w-3xl"><Content /></article>
</BaseLayout>
