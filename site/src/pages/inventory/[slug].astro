---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { pageTitle, usd, statusLabel } from '../../lib/content';

export async function getStaticPaths() {
	return (await getCollection('inventory')).map((unit) => ({ params: { slug: unit.id }, props: { unit } }));
}

const { unit } = Astro.props;
const { Content } = await render(unit);
const { data } = unit;
---

<BaseLayout title={pageTitle(unit)} description={data.description}>
	<nav aria-label="Breadcrumb" class="text-sm text-ink/70"><a href="/inventory/" class="underline">Used equipment</a></nav>
	<div class="mt-4 grid gap-8 lg:grid-cols-2">
		{data.image && <Image src={data.image} alt={data.title} widths={[480, 720, 960]} sizes="(min-width: 1024px) 560px, 100vw" class="w-full rounded-xl" loading="eager" fetchpriority="high" />}
		<div>
			<span class="inline-block rounded bg-white px-2 py-0.5 text-xs font-semibold uppercase tracking-wide ring-1 ring-black/10">{statusLabel[data.status]}</span>
			<h1 class="mt-2 text-3xl font-bold">{data.title}</h1>
			<p class="mt-3 text-2xl font-semibold">{usd(data.price)}</p>
			{data.condition && <p class="mt-1 text-ink/80">{data.condition}</p>}
			<article class="prose mt-6"><Content /></article>
			{data.status !== 'sold' && (
				<a href={`/request-a-quote/?product=${encodeURIComponent(data.title)}`} class="mt-6 inline-block rounded bg-accent px-5 py-2.5 font-semibold text-white hover:brightness-110">Ask about this unit</a>
			)}
		</div>
	</div>
</BaseLayout>
